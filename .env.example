# VARIÁVEIS DE AMBIENTE — Feira Fácil
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais no Git.
# ──────────────────────────────────────────────────────────────

# URL pública do projeto Supabase
VITE_SUPABASE_URL=https://qlzekyiwgawxtfzoufgw.supabase.co

# Chave ANON (pública) — usada pelo app para autenticação normal
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Chave SERVICE ROLE (secreta) — usada APENAS pelo Painel Admin
# ⚠️  Nunca exponha esta chave publicamente.
# ⚠️  Regenere em: Supabase → Settings → API se ela vazar.
# No Vercel: adicione como variável de ambiente no painel de deploy.
VITE_SUPABASE_SERVICE_KEY=sua_service_role_key_aqui
